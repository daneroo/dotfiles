{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["homebrew", "mise", "npm"],
  "properties": {
    "homebrew": {
      "type": "object",
      "required": ["formulae", "casks"],
      "properties": {
        "formulae": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^([^/]+|[^/]+/[^/]+/[^/]+)$"
            }
          }
        },
        "casks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "mise": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^(latest|\\d+(\\.\\d+)*)$"
        }
      }
    },
    "npm": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
